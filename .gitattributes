* text=auto

*.bat text eol=crlf
*.cmd text eol=crlf
gradlew text eol=lf
*.sh text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.jsonl text eol=lf
*.py text eol=lf
*.md text eol=lf
*.jar binary
guest-assets/** text eol=lf

# Runtime manifests validate the exact packaged bytes, including license text.
app/src/main/assets/** -text whitespace=cr-at-eol
app/src/main/assets/NOTICE.GUEST-RUNTIME whitespace=-blank-at-eof,cr-at-eol
