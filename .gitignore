# Developer-local assets remain ignored. Reviewed task documents may be
# explicitly tracked; do not force-add these directories as a whole.
/docs/
temp/

# Private developer assets, screenshots, and logs
*.png
*.jpg
*.jpeg
*.mp4
*.xml.dump
window_dump*.xml
installer*.xml
installer*.png
screen_*.png
test_*.md
