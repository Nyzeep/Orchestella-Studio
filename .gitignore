# --- Branding assets -------------------------------------------------------
# The global *.png / *.jpg rules further up would otherwise drop every
# launcher icon. Re-include only these paths; /docs/ is ignored as a whole, so
# each parent has to be re-opened first and its other children re-ignored
# (`dir/*` keeps the directory walkable without exposing its contents).
!/docs/
/docs/*
!/docs/assets/
/docs/assets/*
!/docs/assets/branding/
!/docs/assets/branding/*.png
!/docs/assets/branding/*.jpg

# Launcher icon bitmaps: adaptive foreground/monochrome + legacy 48dp icons.
!/app/src/main/res/mipmap-*/ic_launcher*.png

# About-page artwork: the mascot at its original ratio, zero-crop.
!/app/src/main/res/drawable-nodpi/mascot_original.png

# Maintainer-curated UI screenshots for the README showcase (session 25).
# The directory itself must be re-opened FIRST: `/docs/assets/*` excludes it, and
# git never walks into an excluded directory, so file-level negations alone stayed
# inert and the README images 404'd on GitHub (fixed in session 26).
!/docs/assets/screenshots/
!/docs/assets/screenshots/*.png
!/docs/assets/screenshots/*.jpg

# --- Signing material ------------------------------------------------------
# Release keystores and their properties must never enter version control
# (docs/standards/RELEASE-SIGNING.md). These patterns are a safety net, not a
# substitute for keeping the material off the repository volume at all.
*.jks
*.keystore
signing.properties

# 会话 25：4K 对齐的旧 QA 载荷隔离库存（勿提交；见目录内 README）
/artifacts/qa-jniLibs-4k-arm64/

# Local release staging (APK+idsig+sums before upload); binaries are gitignored, sums are not.
/artifacts/release-*/

# --- UML kernel build (research/uml-kernel-build) ---------------------------
# Rebuildable via build-bionic*.sh (pinned commit + manifest sha256); build
# trees and the NDK toolchain stay local. Only scripts/defconfigs/manifest/
# checklist/release-assets are tracked.
/research/uml-kernel-build/out/
/research/uml-kernel-build/.toolchain/
