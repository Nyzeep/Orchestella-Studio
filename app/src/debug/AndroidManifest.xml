<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only components. Never merged into release builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Terminal frame benchmark (T03). Launched over adb, needs no launcher icon and no
            exported intent filter beyond an explicit component name. configChanges keeps a
            rotation from recreating the activity mid-measurement.
        -->
        <activity
            android:name=".bench.TerminalBenchActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:exported="true"
            android:theme="@style/Theme.Orchestella" />
    </application>

</manifest>
