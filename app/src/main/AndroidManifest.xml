<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android development grants are prerequisites only. Shizuku client consent
         is separate; this application does not grant permissions or proxy VM operations. -->
    <uses-permission android:name="android.permission.MANAGE_VIRTUAL_MACHINE" />
    <uses-permission android:name="android.permission.USE_CUSTOM_VIRTUAL_MACHINE" />
    <!-- ADR-0011: lifecycle and background execution -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- ADR-0011 §4 & US-35: boot auto-start (disabled by default) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".OrchestellaApplication"
        android:allowBackup="false"
        android:extractNativeLibs="${orcExtractNativeLibs}"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orchestella">
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AboutActivity"
            android:exported="true"
            android:theme="@style/Theme.Orchestella" />

        <activity
            android:name=".SetupWizardActivity"
            android:exported="true"
            android:theme="@style/Theme.Orchestella" />

        <activity
            android:name=".InstanceDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Orchestella" />

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Orchestella" />

        <activity
            android:name=".TerminalActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Runtime log viewer: guest console stream + app logcat, for field diagnosis -->
        <activity
            android:name=".LogViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.Orchestella"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- ADR-0017 & Ticket 43: Android host graphical desktop activity -->
        <activity
            android:name=".DesktopActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity android:name=".GuestFeaturesActivity" android:exported="false"
            android:theme="@style/Theme.Orchestella" />
        <activity android:name=".LocalEditorActivity" android:exported="false"
            android:launchMode="singleTask" android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Orchestella" />
        <activity android:name=".CompatExplanationActivity" android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.Orchestella" />

        <!-- ADR-0011: Persistent foreground service for ongoing guest execution -->
        <service
            android:name=".OrchestellaForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Linux virtual machine execution and guest terminal persistence" />
        </service>

        <!-- ADR-0011 §4 & US-35: Device boot completion listener -->
        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
