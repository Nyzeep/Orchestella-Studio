<?xml version="1.0" encoding="utf-8"?>
<!--
  Returning to the previous page: it re-enters from a 2% offset and fades in,
  210 ms decelerate, so back navigation reads as "the same page, restored".
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@anim/oe_emphasized_decelerate">
    <alpha
        android:duration="210"
        android:fromAlpha="0.92"
        android:toAlpha="1.0" />
    <translate
        android:duration="210"
        android:fromXDelta="-2%p"
        android:toXDelta="0" />
</set>
