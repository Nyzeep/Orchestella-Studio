<?xml version="1.0" encoding="utf-8"?>
<!--
  The outgoing page recedes only slightly (150 ms, emphasized accelerate):
  it stays legible behind the incoming page instead of flashing away, which
  is what made the previous default cross-fade look like a stutter.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@anim/oe_emphasized_accelerate">
    <alpha
        android:duration="150"
        android:fromAlpha="1.0"
        android:toAlpha="0.92" />
    <translate
        android:duration="150"
        android:fromXDelta="0"
        android:toXDelta="-2%p" />
</set>
