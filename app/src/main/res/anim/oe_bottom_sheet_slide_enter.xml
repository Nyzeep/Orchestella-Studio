<?xml version="1.0" encoding="utf-8"?>
<!-- UI-07: bottom sheet enter. Same 20%-of-parent rise + fade the Material
     library ships (m3_bottom_sheet_slide_in), on the dialog token (250 ms)
     and the Material emphasized curve captured by oe_standard.xml. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/oe_motion_duration_dialog_enter"
    android:interpolator="@anim/oe_standard"
    android:shareInterpolator="true">
    <translate
        android:fromYDelta="20%p"
        android:toYDelta="0" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0" />
</set>
