<?xml version="1.0" encoding="utf-8"?>
<!-- UI-07: bottom sheet exit. Same 20% slide-out + fade as the library's
     m3_bottom_sheet_slide_out; duration is the View dialog-exit token. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="@integer/oe_motion_duration_dialog_exit"
    android:interpolator="@anim/oe_standard_accelerate"
    android:shareInterpolator="true">
    <translate
        android:fromYDelta="0"
        android:toYDelta="20%p" />
    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.0" />
</set>
