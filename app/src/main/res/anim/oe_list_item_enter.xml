<?xml version="1.0" encoding="utf-8"?>
<!--
  Single list/card child entering via a LayoutAnimationController stagger
  (see oe_layout_section_stagger): fade in with a 4% parent-height rise,
  300 ms emphasized decelerate. The controller delays each child so the
  whole group reads as a cascade.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@anim/oe_emphasized_decelerate">
    <alpha
        android:duration="@integer/oe_motion_duration_medium2"
        android:fromAlpha="0.0"
        android:toAlpha="1.0" />
    <translate
        android:duration="@integer/oe_motion_duration_medium2"
        android:fromYDelta="4%p"
        android:toYDelta="0" />
</set>
