<?xml version="1.0" encoding="utf-8"?>
<!--
  In-place content state exit: 150 ms fade-out, no movement. Short and
  motionless on purpose so the outgoing state yields to the entering one
  without competing for attention.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@anim/oe_standard_accelerate">
    <alpha
        android:duration="@integer/oe_motion_duration_short3"
        android:fromAlpha="1.0"
        android:toAlpha="0.0" />
</set>
