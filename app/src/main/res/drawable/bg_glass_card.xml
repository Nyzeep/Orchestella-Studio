<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted Glassmorphism card surface inspired by Claude & Moonshot AI (Kimi) aesthetics.
     Semi-translucent fill with 1dp luminous stroke and smooth 20dp corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="@color/glass_card_bg_dark" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_card_stroke_dark" />
</shape>
