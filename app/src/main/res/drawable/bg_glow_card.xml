<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle bloom for hero surfaces: a purple->cyan gradient halo behind a filled panel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="0"
                android:startColor="@color/glow_purple_faint"
                android:endColor="@color/glow_cyan_faint"
                android:type="linear" />
        </shape>
    </item>
    <item android:top="5dp" android:bottom="5dp" android:left="5dp" android:right="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="?attr/colorSurfaceContainer" />
        </shape>
    </item>
</layer-list>
