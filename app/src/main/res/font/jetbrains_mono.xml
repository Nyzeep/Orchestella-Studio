<?xml version="1.0" encoding="utf-8"?>
<!--
  JetBrains Mono NL v2.304, SIL OFL-1.1. Provenance and SHA-256 pinning live in
  NOTICE-jetbrains-mono.md (enforced by JetBrainsMonoNoticeTest).

  Dual attribute mapping so both the framework FontResourcesParser (android:)
  and AppCompat / ResourcesCompat (app:) resolve the same four real TTFs.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/jetbrains_mono_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/jetbrains_mono_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/jetbrains_mono_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/jetbrains_mono_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
    <font
        android:font="@font/jetbrains_mono_italic"
        android:fontStyle="italic"
        android:fontWeight="400"
        app:font="@font/jetbrains_mono_italic"
        app:fontStyle="italic"
        app:fontWeight="400" />
    <font
        android:font="@font/jetbrains_mono_bold_italic"
        android:fontStyle="italic"
        android:fontWeight="700"
        app:font="@font/jetbrains_mono_bold_italic"
        app:fontStyle="italic"
        app:fontWeight="700" />
</font-family>
