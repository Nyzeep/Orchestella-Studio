<?xml version="1.0" encoding="utf-8"?>
<!--
  Oe3 shell host (ticket UI3-12). The ComposeView mounted by MainActivity is
  the entire interface; this bare container only exists so the window has an
  inflated root before the host attaches the shell. All legacy chrome
  (telemetry masthead, page tabs, distro matrix, console controls, gauges)
  was deleted with the old shell.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/oe3_host"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />
