<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/root_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Top Header: Title + Subtitle + Settings Icon Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dashboard_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_title"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnBackground" />

                    <TextView
                        android:id="@+id/dashboard_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/dashboard_subtitle"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOutline" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ssh_manager_button"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:minWidth="40dp"
                    android:minHeight="40dp"
                    android:layout_marginEnd="6dp"
                    app:icon="@drawable/ic_ssh"
                    app:iconSize="20dp"
                    android:contentDescription="SSH 连接管理器" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/theme_toggle_button"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:minWidth="40dp"
                    android:minHeight="40dp"
                    android:layout_marginEnd="6dp"
                    app:icon="@drawable/ic_palette"
                    app:iconSize="20dp"
                    android:contentDescription="切换主题风格" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/about_button"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:minWidth="40dp"
                    android:minHeight="40dp"
                    android:layout_marginEnd="6dp"
                    app:icon="@drawable/ic_info"
                    app:iconSize="20dp"
                    android:contentDescription="@string/about_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_button"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:minWidth="40dp"
                    android:minHeight="40dp"
                    app:icon="@drawable/ic_settings"
                    app:iconSize="20dp"
                    android:contentDescription="@string/settings_title" />
            </LinearLayout>

            <!-- 1. System Hardware Status Card (Host Profile & Virtualization Badge) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/system_status_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_card_stroke_dark"
                app:cardBackgroundColor="@color/glass_card_bg_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/system_virtualization_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="pKVM 硬件虚拟化"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/system_cpu_chip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.1"
                            android:layout_marginStart="12dp"
                            android:drawableStart="@drawable/ic_cpu"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            android:text="8 核心 CPU"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <io.github.nyzeep.orchestella.ui.RingProgressView
                            android:id="@+id/ring_memory"
                            android:layout_width="72dp"
                            android:layout_height="72dp" />

                        <io.github.nyzeep.orchestella.ui.RingProgressView
                            android:id="@+id/ring_storage"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_marginStart="10dp" />

                        <io.github.nyzeep.orchestella.ui.RingProgressView
                            android:id="@+id/ring_battery"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_marginStart="10dp" />
</LinearLayout>

                    <!-- Detailed Runtime Floor & Strategy status -->
                    <TextView
                        android:id="@+id/runtime_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/runtime_status_loading"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOutline" />

                    <!-- Refusal Banner (Honest Refusal) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/refusal_banner"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="12dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/refusal_banner_title"
                        android:textSize="14sp"
                        android:textColor="@color/status_crashed"
                        android:visibility="gone" />

                    <!-- AVF Authorization Wizard Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/upgrade_authorization"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="12dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/wizard_title"
                        android:textSize="14sp"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Hero Create Card: single creation entrance with glow bloom and distro chips.
                 Replaces the former big button card + 7-card carousel; the compact chips reuse
                 the create_* ids so MainActivity wiring keeps working unchanged. -->
            <LinearLayout
                android:id="@+id/card_create_linux_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_glow_card"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_distro_ubuntu"
                        android:contentDescription="Linux Distros" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="创建 Linux 实例"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="官方发行版阵容 · 多层容灾镜像源"
                            android:textSize="12sp"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/create_ubuntu"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="10dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Ubuntu"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/create_debian"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="10dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Debian"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/create_fedora"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="10dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Fedora"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/create_arch"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="10dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Arch"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/create_opensuse"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="10dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="openSUSE"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/create_almalinux"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="10dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="AlmaLinux"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/create_rocky"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="10dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Rocky"
                            android:textSize="12sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_create_linux_instance"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="14dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="12dp"
                    android:text="🚀 选择发行版并启动创建向导"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/create_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/create_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textSize="12sp"
                android:accessibilityLiveRegion="polite" />

            <!-- 3. Instances Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/instances_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/instances_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnBackground" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_import_instance"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    app:icon="@drawable/ic_backup"
                    app:iconSize="16dp"
                    android:text="@string/import_instance_btn"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/instances_count_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_badge"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="0 个实例"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOutline" />
            </LinearLayout>

            <!-- Empty instances state -->
            <TextView
                android:id="@+id/instances_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="32dp"
                android:paddingBottom="32dp"
                android:text="@string/instances_empty"
                android:textSize="14sp"
                android:textColor="?attr/colorOutline"
                android:visibility="gone" />

            <!-- Dynamic UTM Instance Cards Container -->
            <LinearLayout
                android:id="@+id/instance_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
