<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/settings_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/settings_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/settings_title"
            app:titleTextColor="?attr/colorOnSurface" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/settings_root_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layoutAnimation="@anim/oe_layout_section_stagger"
            android:paddingStart="@dimen/oe_space_lg"
            android:paddingEnd="@dimen/oe_space_lg"
            android:paddingTop="@dimen/oe_space_sm"
            android:paddingBottom="36dp">

            <!-- 分节目录（T3 settings IA redesign）：一级页收敛为分节目录，行几何
                 oe_list_item_min_h + trailing chevron，行点击进 SettingsSubActivity
                 对应节；「硬件虚拟化与运行架构」摘要卡保留一级（AVF 徽章 + 启动回退
                 折叠块，决策项），仍在原位。 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_settings_directory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/oe_space_sm"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:cardBackgroundColor="?attr/colorSurfaceContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/oe_space_xs"
                    android:paddingBottom="@dimen/oe_space_xs">

                    <!-- mirror行：oe_list_item_min_h + trailing chevron，进 SettingsSubActivity 对应节 -->
                    <LinearLayout
                        android:id="@+id/row_settings_mirror"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/oe_list_item_min_h"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingStart="@dimen/oe_space_md"
                        android:paddingEnd="@dimen/oe_space_md"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="@dimen/oe_icon_inline"
                            android:layout_height="@dimen/oe_icon_inline"
                            android:src="@drawable/ic_sym_globe"
                            android:importantForAccessibility="no"
                            app:tint="?attr/colorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/oe_space_sm"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_section_mirror_title"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/oe_space_xs"
                                android:text="@string/settings_section_mirror_subtitle"
                                android:textSize="11sp"
                                android:textColor="?attr/colorOutline" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/oe_icon_inline"
                            android:layout_height="@dimen/oe_icon_inline"
                            android:src="@drawable/ic_sym_chevron_right"
                            android:importantForAccessibility="no"
                            app:tint="?attr/colorOutline" />
                    </LinearLayout>

                    <!-- 外观与主题行 -->
                    <LinearLayout
                        android:id="@+id/row_settings_appearance"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/oe_list_item_min_h"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingStart="@dimen/oe_space_md"
                        android:paddingEnd="@dimen/oe_space_md"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="@dimen/oe_icon_inline"
                            android:layout_height="@dimen/oe_icon_inline"
                            android:src="@drawable/ic_sym_palette"
                            android:importantForAccessibility="no"
                            app:tint="?attr/colorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/oe_space_sm"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_section_appearance_title"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/oe_space_xs"
                                android:text="@string/settings_section_appearance_subtitle"
                                android:textSize="11sp"
                                android:textColor="?attr/colorOutline" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/oe_icon_inline"
                            android:layout_height="@dimen/oe_icon_inline"
                            android:src="@drawable/ic_sym_chevron_right"
                            android:importantForAccessibility="no"
                            app:tint="?attr/colorOutline" />
                    </LinearLayout>

                    <!-- about行：oe_list_item_min_h + trailing chevron，进 SettingsSubActivity 对应节 -->
                    <LinearLayout
                        android:id="@+id/row_settings_about"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/oe_list_item_min_h"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingStart="@dimen/oe_space_md"
                        android:paddingEnd="@dimen/oe_space_md"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="@dimen/oe_icon_inline"
                            android:layout_height="@dimen/oe_icon_inline"
                            android:src="@drawable/ic_sym_info"
                            android:importantForAccessibility="no"
                            app:tint="?attr/colorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/oe_space_sm"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_section_about_title"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/oe_space_xs"
                                android:text="@string/settings_section_about_subtitle"
                                android:textSize="11sp"
                                android:textColor="?attr/colorOutline" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/oe_icon_inline"
                            android:layout_height="@dimen/oe_icon_inline"
                            android:src="@drawable/ic_sym_chevron_right"
                            android:importantForAccessibility="no"
                            app:tint="?attr/colorOutline" />
                    </LinearLayout>

                    <!-- 高级行：oe_list_item_min_h + trailing chevron，进 SettingsSubActivity 对应节 -->
                    <LinearLayout
                        android:id="@+id/row_settings_advanced"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/oe_list_item_min_h"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingStart="@dimen/oe_space_md"
                        android:paddingEnd="@dimen/oe_space_md"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="@dimen/oe_icon_inline"
                            android:layout_height="@dimen/oe_icon_inline"
                            android:src="@drawable/ic_sym_tune"
                            android:importantForAccessibility="no"
                            app:tint="?attr/colorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/oe_space_sm"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_section_advanced_title"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/oe_space_xs"
                                android:text="@string/settings_section_advanced_subtitle"
                                android:textSize="11sp"
                                android:textColor="?attr/colorOutline" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/oe_icon_inline"
                            android:layout_height="@dimen/oe_icon_inline"
                            android:src="@drawable/ic_sym_chevron_right"
                            android:importantForAccessibility="no"
                            app:tint="?attr/colorOutline" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================== -->
            <!-- 分区 2：硬件与虚拟化检测 (AVF & Hardware)      -->
            <!-- ============================================== -->
            <LinearLayout
                style="@style/Widget.Orchestella.InlineIconRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/oe_space_xl"
                android:layout_marginBottom="@dimen/oe_space_sm">

                <ImageView
                    style="@style/Widget.Orchestella.InlineIcon"
                    app:srcCompat="@drawable/ic_sym_bolt"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="硬件虚拟化与运行架构"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_settings_virtualization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:cardBackgroundColor="?attr/colorSurfaceContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/oe_space_xl">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="AVF 平台声明与权限"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/txt_settings_avf_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge"
                            android:paddingStart="@dimen/oe_space_sm"
                            android:paddingTop="@dimen/oe_space_xs"
                            android:paddingEnd="@dimen/oe_space_sm"
                            android:paddingBottom="@dimen/oe_space_xs"
                            android:text="检测中…"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_settings_avf_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/oe_space_sm"
                        android:background="?attr/colorSurfaceContainerLow"
                        android:padding="@dimen/oe_space_md"
                        android:text="正在读取平台声明与权限…"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_settings_shizuku"
                        style="@style/Widget.Orchestella.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/oe_space_sm"
                        android:text="@string/shizuku_client_entry" />

                    <!-- Fallback explanation card: tap the header row to
                         expand/collapse (OrchestellaMotion.expand/collapseSection). -->
                    <LinearLayout
                        android:id="@+id/layout_settings_fallback_explanation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/oe_space_md"
                        android:orientation="vertical"
                        android:background="@drawable/bg_status_badge"
                        android:padding="@dimen/oe_space_md">

                        <LinearLayout
                            android:id="@+id/layout_settings_fallback_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/txt_settings_fallback_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="启动验证与回退"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary" />

                            <TextView
                                android:id="@+id/txt_settings_fallback_expand_indicator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="▾"
                                android:textSize="13sp"
                                android:textColor="?attr/colorPrimary" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layout_settings_fallback_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/oe_space_xs"
                                android:text="当前仅检查 AVF 平台声明与应用权限。custom VM 在实例启动时验证创建与运行；预检不满足或启动失败时自动回退至 QEMU。"
                                android:textSize="11sp"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
