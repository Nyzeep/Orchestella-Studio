<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wizard_root_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/wizard_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/wizard_root_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <!-- Wizard Header -->
            <TextView
                android:id="@+id/wizard_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wizard_onboarding_title"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnBackground" />

            <TextView
                android:id="@+id/wizard_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wizard_onboarding_subtitle"
                android:textSize="13sp"
                android:textColor="?attr/colorOutline" />

            <!-- Step Indicator Badge -->
            <TextView
                android:id="@+id/wizard_step_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_status_badge"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="第 1 步 / 共 3 步：环境感知"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />

            <!-- ========================================== -->
            <!-- STEP 1: Environment Detection              -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/step1_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Host Hardware Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_hardware_detect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wizard_step1_card_title"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/wizard_step1_card_desc"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOutline" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="?attr/colorOutlineVariant" />

                        <TextView
                            android:id="@+id/txt_hw_cpu_arch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="芯片架构：ARM64 (aarch64)"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/txt_hw_cpu_cores"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="物理 CPU：8 核心"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/txt_hw_ram_overview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="运存总览：4096 MB 可用 / 8192 MB 总量"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/txt_hw_storage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="私有存储空间：充足可用"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Virtualization Engine Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_virt_detect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wizard_virt_card_title"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/txt_virt_status_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_status_badge"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp"
                            android:text="🎉 L2 硬件虚拟化已就绪"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/status_running" />

                        <TextView
                            android:id="@+id/txt_virt_status_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="检测到 pKVM Stage-2 硬件虚拟化能力，将获得近原生计算与图形性能。"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:id="@+id/layout_virt_auth_actions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_wizard_auth"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                app:cornerRadius="12dp"
                                android:layout_weight="1"
                                android:text="@string/wizard_btn_auth_guide" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_wizard_skip_auth"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                app:cornerRadius="12dp"
                                android:layout_marginStart="8dp"
                                android:text="@string/wizard_btn_skip_auth" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Step 1 Bottom Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_step1_next"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:minHeight="52dp"
                    app:cornerRadius="16dp"
                    android:text="@string/wizard_btn_next"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ========================================== -->
            <!-- STEP 2: Distro Selection                   -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/step2_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wizard_step2_card_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnBackground" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="14dp"
                    android:text="@string/wizard_step2_card_desc"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOutline" />

                <!-- Distro Card 1: Alpine -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_distro_alpine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="?attr/colorPrimary"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_distro_alpine"
                                android:contentDescription="Alpine Linux" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Alpine Linux 3.24"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="⚡ 极简轻量 · 约 4MB · 极客容器"
                                    android:textSize="12sp"
                                    android:textColor="@color/distro_alpine_tint" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/badge_selected_alpine"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_status_badge"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="@string/wizard_distro_selected_badge"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary"
                                android:visibility="visible" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="3dp"
                            android:text="• 极小镜像：rootfs 仅约 4 MB，秒级拉取完毕\n• 超低运存：空闲仅占数十兆 RAM，低配机型毫无压力\n• 极客利器：apk 极速包管理器，适配命令行与轻量容器"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Distro Card 2: Debian -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_distro_debian"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_distro_debian"
                                android:contentDescription="Debian Linux" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Debian GNU/Linux 13"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🐧 完整生态 · 约 90MB · 桌面工作流"
                                    android:textSize="12sp"
                                    android:textColor="@color/distro_debian_tint" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/badge_selected_debian"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_status_badge"
                                android:paddingStart="8dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="3dp"
                                android:text="@string/wizard_distro_selected_badge"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="3dp"
                            android:text="• 浩瀚生态：海量预编译 apt 软件包，兼容全套桌面与服务器开发栈\n• 完整工作流：完美适配 Wayland 桌面、Rust、Python、VS Code Server\n• 开箱即用：内置完整系统运行库与标准 glibc 生态"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Step 2 Navigation Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_step2_prev"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:minHeight="52dp"
                        app:cornerRadius="16dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/wizard_btn_prev"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_step2_next"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:minHeight="52dp"
                        app:cornerRadius="16dp"
                        android:layout_weight="2"
                        android:text="@string/wizard_btn_next"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ========================================== -->
            <!-- STEP 3: Config Confirmation & Download     -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/step3_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Hardware Quota Confirmation Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_recommended_config"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wizard_step3_card_title"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/wizard_step3_card_desc"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOutline" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="?attr/colorOutlineVariant" />

                        <TextView
                            android:id="@+id/txt_cfg_vcpu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="虚拟 CPU：7 核（宿主保留 1 核用于 UI 调度）"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/txt_cfg_ram"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="运存配额：2048 MB（宿主保留 ≥2GB 防闪退线）"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/txt_cfg_disk"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="稀疏磁盘：8 GB（按需占用宿主空间）"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/txt_cfg_gpu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="3D 图形加速：已启用（Mesa VirGL 硬件直通）"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/badge_cfg_zone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_status_badge"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="@string/wizard_config_zone_green"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/zone_green" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Resilient Download & Initialization Panel -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_download_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wizard_download_panel_title"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <!-- Start Button (visible initially) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_wizard_init"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:minHeight="52dp"
                            app:cornerRadius="16dp"
                            android:layout_marginTop="12dp"
                            android:text="@string/wizard_btn_start_init"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Active Download Progress Layout (visible during download) -->
                        <LinearLayout
                            android:id="@+id/layout_download_progress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/txt_download_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="正在拉取 Alpine Linux rootfs 镜像…"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/progress_download_bar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:max="100"
                                android:progress="0"
                                app:indicatorColor="?attr/colorPrimary"
                                app:trackColor="?attr/colorOutlineVariant"
                                app:trackCornerRadius="4dp"
                                app:trackThickness="8dp" />

                            <TextView
                                android:id="@+id/txt_download_speed_eta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="-- MB/s · 已下载 0 MB / 0 MB"
                                android:textSize="12sp"
                                android:textColor="?attr/colorOutline" />

                            <TextView
                                android:id="@+id/txt_download_mirror"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="镜像节点：--"
                                android:textSize="11sp"
                                android:textColor="?attr/colorOutline" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Step 3 Bottom Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_step3_prev"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:minHeight="52dp"
                    app:cornerRadius="16dp"
                    android:text="@string/wizard_btn_prev"
                    android:textSize="15sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
