<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wizard_root_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/wizard_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/wizard_root_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <!-- Wizard Header -->
            <TextView
                android:id="@+id/wizard_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wizard_creation_title"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnBackground" />

            <TextView
                android:id="@+id/wizard_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wizard_creation_subtitle"
                android:textSize="13sp"
                android:textColor="?attr/colorOutline" />

            <!-- Step Indicator Badge -->
            <TextView
                android:id="@+id/wizard_step_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_status_badge"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="第 1 步 / 共 4 步：存储与挂载"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />

            <!-- ========================================== -->
            <!-- STEP 1: Storage & Mounts                   -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/step1_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Distro Selection Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_distro_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="目标 Linux 发行版"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_distro_ubuntu"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                app:cornerRadius="12dp"
                                android:text="🐧 Ubuntu 24.04" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_distro_debian"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                app:cornerRadius="12dp"
                                android:text="🐧 Debian 13" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Virtual Disk Capacity Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_storage_config"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wizard_storage_card_title"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/wizard_storage_card_desc"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOutline" />

                        <TextView
                            android:id="@+id/txt_hw_storage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="私有存储空间：-- GB 可用"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!-- Disk Preset Capsules -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/wizard_disk_size_label"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_disk_4g"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                app:cornerRadius="12dp"
                                android:text="4 GB" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_disk_8g"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                app:cornerRadius="12dp"
                                android:text="8 GB" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_disk_16g"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                app:cornerRadius="12dp"
                                android:text="16 GB" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_disk_32g"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:cornerRadius="12dp"
                                android:text="32 GB" />
                        </LinearLayout>

                        <!-- Custom Disk Input -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_custom_disk"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            android:hint="@string/wizard_disk_custom_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_custom_disk_gb"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:textSize="14sp"
                                android:text="8" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Insufficient Storage Warning Alert -->
                        <TextView
                            android:id="@+id/txt_storage_warning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="12sp"
                            android:textColor="@color/zone_red"
                            android:visibility="gone" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:background="?attr/colorOutlineVariant" />

                        <!-- Host Shared Directory Mount Checkbox -->
                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/chk_mount_shared_dir"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/wizard_mount_shared_dir_label"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_shared_dir_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:text="@string/wizard_mount_shared_dir_desc"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOutline" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pick_shared_dir"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:layout_marginTop="6dp"
                            app:cornerRadius="12dp"
                            android:text="@string/wizard_select_shared_folder"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/txt_shared_folder_path"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:layout_marginTop="4dp"
                            android:textSize="12sp"
                            android:textColor="?attr/colorPrimary"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Step 1 Bottom Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_step1_next"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:minHeight="52dp"
                    app:cornerRadius="16dp"
                    android:text="@string/wizard_btn_next"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ========================================== -->
            <!-- STEP 2: Network & Mirror Selector          -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/step2_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Network Diagnosis Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_network_diag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wizard_network_card_title"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/wizard_network_card_desc"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOutline" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="?attr/colorOutlineVariant" />

                        <TextView
                            android:id="@+id/txt_net_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="网络连接：Wi-Fi"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/txt_net_ip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="宿主 IP：192.168.1.100"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/txt_net_gateway"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="默认网关：10.0.2.2"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/txt_net_dns"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="DNS 服务器：8.8.8.8"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurface" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_test_network"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cornerRadius="12dp"
                                android:text="@string/wizard_net_test_btn" />

                            <TextView
                                android:id="@+id/txt_net_test_result"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:textSize="12sp"
                                android:textColor="@color/zone_green" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Mirror Selection Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_mirror_select"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wizard_mirror_selector_label"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <Spinner
                            android:id="@+id/spinner_mirror_source"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_status_badge"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />

                        <TextView
                            android:id="@+id/txt_mirror_preview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textSize="12sp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="?attr/colorOutline" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Step 2 Navigation Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_step2_prev"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:minHeight="52dp"
                        app:cornerRadius="16dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/wizard_btn_prev"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_step2_next"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:minHeight="52dp"
                        app:cornerRadius="16dp"
                        android:layout_weight="2"
                        android:text="@string/wizard_btn_next"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ========================================== -->
            <!-- STEP 3: Hardware Quota                     -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/step3_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Hardware Allocation Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_hardware_quota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wizard_hardware_card_title"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/wizard_hardware_card_desc"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOutline" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="?attr/colorOutlineVariant" />

                        <!-- vCPU Slider & Stepper -->
                        <TextView
                            android:id="@+id/txt_cfg_vcpu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="虚拟 CPU：4 核心"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="2dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_vcpu_minus"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:padding="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="12dp"
                                android:text="-"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/slider_vcpu"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp"
                                android:valueFrom="1"
                                android:valueTo="8"
                                android:stepSize="1"
                                android:value="4" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_vcpu_plus"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:padding="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="12dp"
                                android:text="+"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- RAM Slider -->
                        <TextView
                            android:id="@+id/txt_cfg_ram"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="运行内存 (RAM)：2048 MB"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/slider_ram"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="512"
                            android:valueTo="6144"
                            android:stepSize="256"
                            android:value="2048" />

                        <!-- Dynamic Safety Zone Indicator -->
                        <TextView
                            android:id="@+id/badge_cfg_zone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_status_badge"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="@string/wizard_config_zone_green"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/zone_green" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_avf_auth_wizard"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            app:cornerRadius="12dp"
                            android:text="@string/wizard_btn_auth_guide"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Step 3 Navigation Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_step3_prev"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:minHeight="52dp"
                        app:cornerRadius="16dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/wizard_btn_prev"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_step3_next"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:minHeight="52dp"
                        app:cornerRadius="16dp"
                        android:layout_weight="2"
                        android:text="@string/wizard_btn_next"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ========================================== -->
            <!-- STEP 4: Startup Tasks & Creation           -->
            <!-- ========================================== -->
            <LinearLayout
                android:id="@+id/step4_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Startup Tasks Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_startup_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wizard_startup_card_title"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/wizard_startup_card_desc"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOutline" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="?attr/colorOutlineVariant" />

                        <!-- Auto Update Checkbox -->
                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/chk_auto_update"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/wizard_startup_auto_update_label"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_update_command_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:layout_marginTop="2dp"
                            android:text="勾选后将自动生成 firstboot 脚本并在后台执行更新"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOutline" />

                        <TextView
                            android:id="@+id/txt_update_command_preview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_status_badge"
                            android:padding="8dp"
                            android:typeface="monospace"
                            android:textSize="11sp"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Spec Summary Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_spec_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="实例配置清单"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/txt_creation_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Creation & Download Panel -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_download_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_wizard_init"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:minHeight="52dp"
                            app:cornerRadius="16dp"
                            android:text="@string/wizard_btn_create_instance"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Active Download Progress Layout -->
                        <LinearLayout
                            android:id="@+id/layout_download_progress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/txt_download_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="正在拉取 rootfs 镜像…"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/progress_download_bar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:max="100"
                                android:progress="0"
                                app:indicatorColor="?attr/colorPrimary"
                                app:trackColor="?attr/colorOutlineVariant"
                                app:trackCornerRadius="4dp"
                                app:trackThickness="8dp" />

                            <TextView
                                android:id="@+id/txt_download_speed_eta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="-- MB/s · 已下载 0 MB / 0 MB"
                                android:textSize="12sp"
                                android:textColor="?attr/colorOutline" />

                            <TextView
                                android:id="@+id/txt_download_mirror"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="镜像节点：--"
                                android:textSize="11sp"
                                android:textColor="?attr/colorOutline" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Step 4 Bottom Prev Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_step4_prev"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:minHeight="52dp"
                    app:cornerRadius="16dp"
                    android:text="@string/wizard_btn_prev"
                    android:textSize="15sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
