<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/oe_space_md"
    android:paddingEnd="@dimen/oe_space_md"
    android:paddingTop="@dimen/oe_space_sm"
    android:paddingBottom="@dimen/oe_space_sm">

    <ImageView
        android:id="@+id/item_distro_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="@dimen/oe_space_md"
        android:src="@drawable/ic_distro_ubuntu"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_distro_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ubuntu LTS"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/item_distro_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/oe_space_xs"
            android:text="通用开发 · 云原生首选"
            android:textSize="11sp"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

</LinearLayout>
