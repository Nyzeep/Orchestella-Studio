<?xml version="1.0" encoding="utf-8"?>
<!-- 端口转发规则条目（sheet 内数据项）
     卡片层级：二级数据卡；pre-bind 归一到 bg_oe_card 族
     （colorSurfaceContainerLow + 发丝线），运行时 ThemeApplier 重涂。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_pf_rule"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/oe_space_xs"
    android:layout_marginBottom="@dimen/oe_space_xs"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeWidth="@dimen/oe_stroke_hairline"
    app:strokeColor="?attr/colorOutlineVariant"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/oe_space_md"
        android:paddingEnd="@dimen/oe_space_sm"
        android:paddingTop="@dimen/oe_space_sm"
        android:paddingBottom="@dimen/oe_space_sm">

        <TextView
            android:id="@+id/tv_rule_protocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_badge"
            android:paddingStart="@dimen/oe_icon_inline_gap"
            android:paddingTop="@dimen/oe_space_xs"
            android:paddingEnd="@dimen/oe_icon_inline_gap"
            android:paddingBottom="@dimen/oe_space_xs"
            android:text="TCP"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginEnd="@dimen/oe_space_sm" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_rule_ports"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8080 → 8080"
                android:textSize="14sp"
                android:textStyle="bold"
                android:typeface="monospace"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tv_rule_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Web service"
                android:textSize="11sp"
                android:textColor="?attr/colorOutline" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_rule_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:checked="true"
            android:layout_marginEnd="@dimen/oe_space_xs" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_rule_delete"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            app:icon="@drawable/ic_sym_delete"
            app:iconTint="?attr/colorError"
            android:contentDescription="删除该端口转发规则" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
