<?xml version="1.0" encoding="utf-8"?>
<!-- 仪表盘实例卡（TAB2 列表项）
     卡片层级：一级决策卡（实例即主操作对象）；规格行/按钮区间距按
     信息密度收紧（oe_space_sm 行距），legacy #16171D/#2E323B 灰边
     归一到 bg_oe_card 族 pre-bind 值（运行时 ThemeApplier 统一重涂）。
     UI 重新设计轮（C6 布局段）：卡内边距归 oe_card_pad、卡距归
     oe_card_gap、图标盒归 oe_icon_box_lg，电源键 38dp 升
     oe_btn_h_primary(48dp) 档；「终端」次级按钮与电源键同排同高
     （id 沿用旧别名 card_btn_terminal；旧 0dp 隐藏别名钮已删除——
     同 id 双钮触发 lint DuplicateIds，C6-B 逻辑接线即接此新钮）。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/instance_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="0dp"
    android:layout_marginBottom="@dimen/oe_card_gap"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeWidth="@dimen/oe_stroke_hairline"
    app:strokeColor="?attr/colorOutlineVariant"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/oe_card_pad">

        <!-- Row 1: Distro Icon + Title & ID + State Capsule Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="@dimen/oe_icon_box_lg"
                android:layout_height="@dimen/oe_icon_box_lg"
                android:layout_marginEnd="@dimen/oe_space_md"
                android:background="@drawable/bg_icon_container">

                <ImageView
                    android:id="@+id/card_distro_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_distro_ubuntu"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/card_distro_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="Ubuntu Linux"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#F5F4F0" />

                <TextView
                    android:id="@+id/card_instance_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/oe_space_xs"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:text="ID: alpine-001"
                    android:textSize="11sp"
                    android:textColor="#8E929B" />
            </LinearLayout>

            <TextView
                android:id="@+id/card_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="160dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:background="@drawable/bg_status_badge"
                android:paddingStart="@dimen/oe_space_sm"
                android:paddingTop="@dimen/oe_space_xs"
                android:paddingEnd="@dimen/oe_space_sm"
                android:paddingBottom="@dimen/oe_space_xs"
                android:text="[ 已停止 ]"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/status_stopped" />
        </LinearLayout>

        <!-- Row 2: Specs Summary & Virtual IP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/oe_space_sm"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                style="@style/Widget.Orchestella.InlineIconRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    style="@style/Widget.Orchestella.InlineIcon"
                    app:srcCompat="@drawable/ic_sym_memory"
                    app:tint="#8E929B" />

                <TextView
                    android:id="@+id/card_hardware_specs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:text="2 vCPU · 2048 MB · 8 GB"
                    android:textSize="11sp"
                    android:textColor="#8E929B" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.Orchestella.InlineIconRow">

                <ImageView
                    style="@style/Widget.Orchestella.InlineIcon"
                    app:srcCompat="@drawable/ic_sym_lan"
                    app:tint="#8E929B" />

                <TextView
                    android:id="@+id/card_ip_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="192.168.127.15"
                    android:textSize="11sp"
                    android:textColor="#8E929B" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/oe_space_sm"
            android:layout_marginBottom="@dimen/oe_space_sm"
            android:background="#2E323B" />

        <!-- Row 3: Detail Hint & High-Priority Quick Actions（UI 重新设计轮：
             运行中实例卡新增「终端」次级按钮——与电源键同排同高
             oe_btn_h_primary，占位默认 gone，点击接线随逻辑提交） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="MACH.ID // 点击进入控制台"
                android:textSize="10sp"
                android:textColor="#8E929B" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/card_btn_terminal"
                style="@style/Widget.Orchestella.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/oe_btn_h_primary"
                app:cornerRadius="0dp"
                app:icon="@drawable/ic_sym_terminal"
                app:iconSize="16dp"
                android:paddingStart="@dimen/oe_space_md"
                android:paddingEnd="@dimen/oe_space_md"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textStyle="bold"
                android:text="@string/instance_card_terminal_action"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/card_btn_power"
                style="@style/Widget.Orchestella.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/oe_btn_h_primary"
                android:layout_marginStart="@dimen/oe_space_sm"
                app:cornerRadius="0dp"
                app:icon="@drawable/ic_sym_power_settings_new"
                app:iconSize="16dp"
                android:paddingStart="@dimen/oe_space_md"
                android:paddingEnd="@dimen/oe_space_md"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textStyle="bold"
                android:text="开机" />

            <!-- Hidden alias button for backward compatibility if any callers reference it -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/card_btn_launch"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/card_btn_more"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/card_btn_desktop"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/card_btn_crash_log"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
