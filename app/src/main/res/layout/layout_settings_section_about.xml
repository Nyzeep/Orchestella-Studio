<?xml version="1.0" encoding="utf-8"?>
<!-- 「关于与合规」设置子页节布局（T3 settings IA redesign）。
     旧一级页「关于与官方商标声明」卡搬入：版本行 id 不变；10 行商标长文
     折叠为「商标与合规声明」折叠块（OrchestellaMotion.expand/collapseSection，
     与虚拟化卡「启动验证与回退」折叠块同款机制），默认收起。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        style="@style/Widget.Orchestella.InlineIconRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/oe_space_sm"
        android:layout_marginBottom="@dimen/oe_space_sm">

        <ImageView
            style="@style/Widget.Orchestella.InlineIcon"
            app:srcCompat="@drawable/ic_sym_info"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关于平台与官方商标合规"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_settings_about"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:cardBackgroundColor="?attr/colorSurfaceContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/oe_space_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Orchestella Studio"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/txt_settings_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/oe_space_xs"
                android:text="版本：v0.1.5 · Phase 5.0"
                android:textSize="13sp"
                android:textColor="?attr/colorOutline" />

            <!-- 商标与合规声明折叠块：tap header row to expand/collapse
                 (OrchestellaMotion.expand/collapseSection)。默认收起（▸）。 -->
            <LinearLayout
                android:id="@+id/layout_settings_trademark_disclosure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/oe_space_md"
                android:orientation="vertical"
                android:background="@drawable/bg_status_badge"
                android:padding="@dimen/oe_space_md">

                <LinearLayout
                    android:id="@+id/layout_settings_trademark_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/txt_settings_trademark_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_trademark_disclosure_title"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/txt_settings_trademark_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▸"
                        android:textSize="13sp"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_settings_trademark_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/oe_space_xs"
                        android:text="官方发行版商标合规声明：\n• Ubuntu 是 Canonical Ltd. 的注册商标。\n• Debian 是 Software in the Public Interest, Inc. 的注册商标。\n• Fedora 是 Red Hat, Inc. 的注册商标。\n• Arch Linux 是 Judd Vinet 与 Aaron Griffin 的注册商标。\n• openSUSE 是 SUSE LLC 的商标。\n• AlmaLinux 是 AlmaLinux OS Foundation 的商标。\n• Rocky Linux 是 Rocky Enterprise Software Foundation 的商标。\n所有官方图标资源均遵循各项目开源品牌规范使用。"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
