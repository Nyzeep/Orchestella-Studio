<?xml version="1.0" encoding="utf-8"?>
<!-- 「引擎与授权」设置子页节布局（UI3-04）。
     原 SettingsActivity 一级页的 AVF 摘要卡与「启动验证与回退」折叠块整体
     迁入：控件 id 一律不变（txt_settings_avf_badge / txt_settings_avf_details /
     btn_settings_shizuku / layout_settings_fallback_*），探测逻辑与文案阈值
     不变。QEMU/UML 的定位用一行静态说明给出，不新增探测面。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        style="@style/Widget.Orchestella.InlineIconRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/oe_space_sm"
        android:layout_marginBottom="@dimen/oe_space_sm">

        <ImageView
            style="@style/Widget.Orchestella.InlineIcon"
            app:srcCompat="@drawable/ic_sym_bolt"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_system_section_title"
            android:textAppearance="@style/TextAppearance.Orchestella.Body"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/oe_space_sm"
        android:text="@string/config_system_hint"
        android:textAppearance="@style/TextAppearance.Orchestella.Caption"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Flat tonal block, no stroke: spec §6 forbids legacy card containers
         and strokes in new page files. The legacy settings shell is
         square-cornered anyway. -->
    <LinearLayout
        android:id="@+id/card_settings_virtualization"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorSurfaceContainer"
        android:padding="@dimen/oe_space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/config_system_card_title"
                    android:textAppearance="@style/TextAppearance.Orchestella.Section"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/txt_settings_avf_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_badge"
                    android:paddingStart="@dimen/oe_space_sm"
                    android:paddingTop="@dimen/oe_space_xs"
                    android:paddingEnd="@dimen/oe_space_sm"
                    android:paddingBottom="@dimen/oe_space_xs"
                    android:text="@string/config_system_badge_probing"
                    android:textAppearance="@style/TextAppearance.Orchestella.Caption"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_settings_avf_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/oe_space_sm"
                android:background="?attr/colorSurfaceContainerLow"
                android:padding="@dimen/oe_space_md"
                android:text="@string/config_system_details_probing"
                android:textAppearance="@style/TextAppearance.Orchestella.Caption"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_settings_shizuku"
                style="@style/Widget.Orchestella.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/oe_space_sm"
                android:text="@string/shizuku_client_entry" />

            <!-- Fallback explanation card: tap the header row to
                 expand/collapse (OrchestellaMotion.expand/collapseSection). -->
            <LinearLayout
                android:id="@+id/layout_settings_fallback_explanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/oe_space_md"
                android:orientation="vertical"
                android:background="@drawable/bg_status_badge"
                android:padding="@dimen/oe_space_md">

                <LinearLayout
                    android:id="@+id/layout_settings_fallback_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/txt_settings_fallback_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/config_system_fallback_title"
                        android:textAppearance="@style/TextAppearance.Orchestella.Meta"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/txt_settings_fallback_expand_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▾"
                        android:textAppearance="@style/TextAppearance.Orchestella.Meta"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_settings_fallback_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/oe_space_xs"
                        android:text="@string/config_system_fallback_body"
                        android:textAppearance="@style/TextAppearance.Orchestella.Caption"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

    </LinearLayout>

</LinearLayout>
