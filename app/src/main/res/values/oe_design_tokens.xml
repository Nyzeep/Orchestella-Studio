<?xml version="1.0" encoding="utf-8"?>
<!--
  LEGACY (UI-01, 2026-11-17): this file is the pre-Oe3 XML token mirror and is
  no longer a source of truth. Compose geometry/typography tokens live in
  `ui/design/tokens` (OeShape / OeSpacing / OeType / OeMotion). The dims below
  survive only for the remaining View-system screens; treat them as frozen and
  delete this file once those screens migrate to Compose.
  Migration complete → delete this file.

  UI-15 sweep (2026-11-18) — what is left, and why each dim still exists:
    oe_corner_md / oe_space_* / oe_icon_inline_gap / oe_icon_inline /
    oe_stroke_hairline / oe_card_gap / oe_btn_h_secondary
      consumed only by the un-migrated View screens (activity_about,
      activity_desktop, activity_instance_detail, activity_settings_sub,
      layout_settings_section_*) and by styles.xml button styles those screens
      reuse. They are the "未迁移 Activity 所需项" the ticket allows.
    oe_corner_card (new in UI-15)
      XML mirror of OeShape.xl = 24dp; the four View layouts cannot read the
      Kotlin token, so the card radius needs a dimen to stop being 0dp.
    oe_space_xxxl (32dp)
      deleted in UI-15 — zero consumers in src.
-->
<!--
  B-lane (round 2026-11-09) design tokens, oe_-prefixed, continuing the
  oe_motion_tokens.xml naming convention. XML carries the static geometry /
  typography tokens; color tokens stay derived in ThemeColors (hairline family)
  because every palette value must re-resolve per theme — one mechanism per
  concern, mirroring how Now in Android keeps Color/Shape/Spacing/Type in one
  designsystem home and how DroidKaigi's conference-app gates all components
  through its Kaigi theme instead of scattered literals.

  Sources:
    https://m3.material.io/styles/shape/corner-radius-scale
    https://m3.material.io/styles/color/roles
    https://github.com/android/nowinandroid (core/designsystem)
    https://github.com/DroidKaigi/conference-app-2024 (core/designsystem)
-->
<resources>
    <!-- 圆角 scale (M3 corner radius tokens): sharp industrial surfaces stay 0,
         chips/inputs 8/12, cards 16 (aligns ThemeStore.DEFAULT_CORNER_RADIUS_DP),
         oversized cards / sheets 28. ThemeApplier merges these only-grow at
         runtime, so a user's larger corner setting always wins. -->
    <dimen name="oe_corner_md">12dp</dimen>
    <!-- 页面卡圆角：OeShape.xl = 24dp 的 XML 镜像。UI-15 清扫引入——
         旧 Activity 的 MaterialCardView 原先显式 0dp，是 v4 前的直角语言；
         Compose 侧真源仍是 ui/design/tokens/Shape.kt，此处只为 View 系统
         无法读 Kotlin token 而镜像一个值。 -->
    <dimen name="oe_corner_card">24dp</dimen>

    <!-- 间距 scale: 4dp baseline grid (M3 spacing guidance). The one non-multiple
         below is an optical half-step for icon-to-text gaps, matching the tuned
         drawablePadding this app already ships. -->
    <dimen name="oe_space_xs">4dp</dimen>
    <dimen name="oe_space_sm">8dp</dimen>
    <dimen name="oe_space_md">12dp</dimen>
    <dimen name="oe_space_lg">16dp</dimen>
    <dimen name="oe_space_xl">20dp</dimen>
    <dimen name="oe_space_xxl">24dp</dimen>
    <dimen name="oe_icon_inline_gap">6dp</dimen>

    <!-- 发丝线 stroke: one device-density pixel, matching ThemeApplier's
         runtime hairline (density-based) for pre-bind consistency. -->
    <dimen name="oe_stroke_hairline">1dp</dimen>

    <!-- 16dp inline icon: the compound-drawable replacement size (see
         Widget.Orchestella.InlineIcon) and the detail-tab leading icon size. -->
    <dimen name="oe_icon_inline">16dp</dimen>

    <!-- UI 重新设计轮（2026-11-14）语义 token：卡片/按钮的层级几何。
         消费规则（同层级同 token）：卡内外边距间隙用 oe_card_gap；卡内
         次级按钮高度用 oe_btn_h_secondary（同层级同 token，不另立档位）。
         同期引入的列表行/组间距档位已随旧壳清理移除，Oe3 侧几何由
         ui/oe3/tokens 接管。 -->
    <dimen name="oe_card_gap">12dp</dimen>
    <!-- View mirrors of the Compose toolbar and action geometry. -->
    <dimen name="oe_top_bar">72dp</dimen>
    <dimen name="oe_btn_h_secondary">48dp</dimen>
    <dimen name="oe_btn_visual_inset">2dp</dimen>
    <dimen name="oe_btn_section_visual_inset">6dp</dimen>
    <dimen name="oe_btn_pill_radius">22dp</dimen>
</resources>
