<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Orchestella" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Session 19 (T-D): one Material Motion transition vocabulary for every
             Activity instead of each window using the platform default fade. -->
        <item name="android:windowAnimationStyle">@style/Animation.Orchestella.Activity</item>
    </style>

    <style name="Theme.DroidLayer" parent="Theme.Orchestella" />

    <!-- Round 2026-11-07 (Lane B): completed the vocabulary to task-level
         transitions. Every entry point a task can appear or leave through —
         launcher cold start, NEW_TASK, recents to front, back out of the
         root, home, launch-behind — now uses the same oe_ curve family, so
         the platform default zoom/fade never flashes through mid-flow.
         dream/wallpaper/fragment attrs are intentionally left inherited:
         this app has no dreams, no wallpaper-backed windows and no
         TRANSIT_FRAGMENT_* callers. -->
    <style name="Animation.Orchestella.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/oe_activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/oe_activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/oe_activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/oe_activity_close_exit</item>
        <item name="android:taskOpenEnterAnimation">@anim/oe_activity_open_enter</item>
        <item name="android:taskOpenExitAnimation">@anim/oe_activity_open_exit</item>
        <item name="android:taskCloseEnterAnimation">@anim/oe_activity_close_enter</item>
        <item name="android:taskCloseExitAnimation">@anim/oe_activity_close_exit</item>
        <item name="android:taskToFrontEnterAnimation">@anim/oe_activity_open_enter</item>
        <item name="android:taskToFrontExitAnimation">@anim/oe_activity_open_exit</item>
        <item name="android:taskToBackEnterAnimation">@anim/oe_activity_close_enter</item>
        <item name="android:taskToBackExitAnimation">@anim/oe_activity_close_exit</item>
        <item name="android:launchTaskBehindTargetAnimation">@anim/oe_launch_behind_target</item>
        <item name="android:launchTaskBehindSourceAnimation">@anim/oe_launch_behind_source</item>
    </style>

    <style name="Widget.Orchestella.DiskPreset" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">0dp</item>
    </style>
</resources>
