<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Orchestella" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Session 19 (T-D): one Material Motion transition vocabulary for every
             Activity instead of each window using the platform default fade. -->
        <item name="android:windowAnimationStyle">@style/Animation.Orchestella.Activity</item>
        <!-- UI-07: the two dialog families were the last windows on library
             defaults (400/300 ms). Both now resolve through Orchestella
             overlays so their window animation reads oe_motion_duration_*
             like every other surface. Shape is unchanged; only the clock. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Orchestella.MaterialAlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Orchestella.BottomSheetDialog</item>
    </style>


    <!-- ==================================================== -->
    <!-- UI-07 floating layers: AppCompat/Material dialogs and modal bottom
         sheets. The overlay keeps every Material default (alertDialogStyle,
         button bar styles, scrim opacity); only android:windowAnimationStyle
         is replaced, so the tokens reach res/anim without touching call sites
         (MaterialAlertDialogBuilder / BottomSheetDialog read these two theme
         attributes on their own). -->
    <!-- ==================================================== -->

    <style name="ThemeOverlay.Orchestella.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowAnimationStyle">@style/Animation.Orchestella.Dialog</item>
    </style>

    <style name="ThemeOverlay.Orchestella.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowAnimationStyle">@style/Animation.Orchestella.BottomSheetDialog</item>
    </style>

    <style name="Animation.Orchestella.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/oe_dialog_fade_enter</item>
        <item name="android:windowExitAnimation">@anim/oe_dialog_fade_exit</item>
    </style>

    <style name="Animation.Orchestella.BottomSheetDialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/oe_bottom_sheet_slide_enter</item>
        <item name="android:windowExitAnimation">@anim/oe_bottom_sheet_slide_exit</item>
    </style>


    <!-- Round 2026-11-07 (Lane B): completed the vocabulary to task-level
         transitions. Every entry point a task can appear or leave through —
         launcher cold start, NEW_TASK, recents to front, back out of the
         root, home, launch-behind — now uses the same oe_ curve family, so
         the platform default zoom/fade never flashes through mid-flow.
         dream/wallpaper/fragment attrs are intentionally left inherited:
         this app has no dreams, no wallpaper-backed windows and no
         TRANSIT_FRAGMENT_* callers. -->
    <style name="Animation.Orchestella.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/oe_activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/oe_activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/oe_activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/oe_activity_close_exit</item>
        <item name="android:taskOpenEnterAnimation">@anim/oe_activity_open_enter</item>
        <item name="android:taskOpenExitAnimation">@anim/oe_activity_open_exit</item>
        <item name="android:taskCloseEnterAnimation">@anim/oe_activity_close_enter</item>
        <item name="android:taskCloseExitAnimation">@anim/oe_activity_close_exit</item>
        <item name="android:taskToFrontEnterAnimation">@anim/oe_activity_open_enter</item>
        <item name="android:taskToFrontExitAnimation">@anim/oe_activity_open_exit</item>
        <item name="android:taskToBackEnterAnimation">@anim/oe_activity_close_enter</item>
        <item name="android:taskToBackExitAnimation">@anim/oe_activity_close_exit</item>
        <item name="android:launchTaskBehindTargetAnimation">@anim/oe_launch_behind_target</item>
        <item name="android:launchTaskBehindSourceAnimation">@anim/oe_launch_behind_source</item>
    </style>

</resources>
