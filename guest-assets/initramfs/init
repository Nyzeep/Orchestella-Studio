    local continuation_begin='\[\e]133;B;continuation=1\a\]'
    local continuation_end='\[\e]133;B;continuation=2\a\]'
    PS2="${PS2#"$continuation_begin"}"
    PS2="${PS2%"$continuation_end"}"
    PS2="$continuation_begin${PS2-'> '}$continuation_end"
