# Configures eth0 in the INITRAMFS (busybox ip) before switch_root: the IP and
# routes live in the kernel and survive switch_root, so distros without any
# network tooling (ubuntu-base ships no ip/ifconfig/ping) inherit a working
# uplink. Addressing comes from the host via kernel arguments (gvproxy plane).
configure_guest_network() {
    mount_point="$1"
    GUEST_IP="$(kernel_argument orchestella.guest_ip || true)"
    GUEST_GW="$(kernel_argument orchestella.guest_gw || true)"
    GUEST_MASK="$(kernel_argument orchestella.guest_mask || true)"
    GUEST_DNS="$(kernel_argument orchestella.guest_dns || true)"
    BUSYBOX=""
    [ -x /bin/busybox ] && BUSYBOX="/bin/busybox"
    [ -z "$BUSYBOX" ] && [ -x /usr/bin/busybox ] && BUSYBOX="/usr/bin/busybox"
    if [ -z "$BUSYBOX" ] || [ -z "$GUEST_IP" ]; then
        return 0
    fi
    "$BUSYBOX" ip link set eth0 up 2>/dev/null || true
    "$BUSYBOX" ip addr add "$GUEST_IP/${GUEST_MASK:-255.255.255.0}" dev eth0 2>/dev/null || true
    [ -n "$GUEST_GW" ] && "$BUSYBOX" ip route add default via "$GUEST_GW" 2>/dev/null || true
    rm -f "$mount_point/etc/resolv.conf" 2>/dev/null || true
    {
        [ -n "$GUEST_DNS" ] && printf 'nameserver %s\n' "$GUEST_DNS"
        printf 'nameserver 223.5.5.5\n'
        printf 'nameserver 119.29.29.29\n'
        printf 'nameserver 1.1.1.1\n'
        printf 'nameserver 8.8.8.8\n'
    } > "$mount_point/etc/resolv.conf" 2>/dev/null || true
    chmod 0644 "$mount_point/etc/resolv.conf" 2>/dev/null || true
    {
        echo "== Orchestella network diagnostics (initramfs) =="
        "$BUSYBOX" ip -4 addr show eth0 2>/dev/null
        "$BUSYBOX" ip route 2>/dev/null
        echo "-- resolv.conf --"
        cat "$mount_point/etc/resolv.conf" 2>/dev/null
        echo "-- gateway ping (192.168.127.1) --"
        "$BUSYBOX" ping -c1 -W2 192.168.127.1 2>&1 | tail -2
        echo "-- upstream ping (223.5.5.5) --"
        "$BUSYBOX" ping -c1 -W2 223.5.5.5 2>&1 | tail -2
        echo "-- dns lookup via 223.5.5.5 --"
        "$BUSYBOX" nslookup mirrors.tuna.tsinghua.edu.cn 223.5.5.5 2>&1 | head -6
        echo "-- tcp probe (nc 223.5.5.5:53, no dns needed) --"
        echo "" | "$BUSYBOX" nc -w3 223.5.5.5 53 2>&1 && echo "tcp53: connected" || echo "tcp53: failed"
        echo "-- tcp probe (nc 223.5.5.5:80) --"
        echo "" | "$BUSYBOX" nc -w3 223.5.5.5 80 2>&1 && echo "tcp80: connected" || echo "tcp80: failed"
        echo "== diagnostics end =="
    } > /dev/console 2>&1 || true
}
