[ -z "$ROOT_FILESYSTEM_TYPE" ] || fail root-volume-unmountable

INPUT_TAG="$(kernel_argument droidlayer.input_tag || true)"
case "$INPUT_TAG" in *[!A-Za-z0-9._-]*|'') fail invalid-input-tag ;; esac
mkdir -p /run/droidlayer-input
# Provisioning input transport: the 9p virtio mount is the canonical channel.
# Builders that ship without virtio-9p (Android bionic build disables virtfs)
# receive the same verified input files as a second, gzipped newc cpio segment
# appended to the initramfs; the kernel unpacks it into
# /opt/droidlayer/embedded-input and the .active sentinel keeps the fallback
# fail-closed. The guest still re-verifies the rootfs digest below.
INPUT_DIR=""
if mount -t 9p -o trans=virtio,version=9p2000.L,ro "$INPUT_TAG" /run/droidlayer-input 2>/dev/null; then
    INPUT_DIR=/run/droidlayer-input
elif [ -f /opt/droidlayer/embedded-input/.active ]; then
    INPUT_DIR=/opt/droidlayer/embedded-input
    log 'using embedded provision input'
else
    fail mount-input
fi

ROOTFS_FILE="$(cat /etc/droidlayer/rootfs.file 2>/dev/null || true)"
EXPECTED_ROOTFS_SHA256="$(cat /etc/droidlayer/rootfs.sha256 2>/dev/null || true)"
ROOTFS_PATH="$INPUT_DIR/$ROOTFS_FILE"
TOKEN_PATH="$INPUT_DIR/bridge.token"

if [ -z "$ROOTFS_FILE" ] || [ ! -f "$ROOTFS_PATH" ]; then
    for candidate in "$INPUT_DIR"/*.tar.xz "$INPUT_DIR"/*.tar.gz "$INPUT_DIR"/*.tar; do
        if [ -f "$candidate" ]; then
            ROOTFS_PATH="$candidate"
            ROOTFS_FILE="$(basename "$candidate")"
            break
        fi
    done
fi

[ -f "$ROOTFS_PATH" ] || fail rootfs-missing
if [ -n "$EXPECTED_ROOTFS_SHA256" ] && [ -f "/etc/droidlayer/rootfs.file" ] && [ "$ROOTFS_FILE" = "$(cat /etc/droidlayer/rootfs.file)" ]; then
    ACTUAL_ROOTFS_SHA256="$(sha256sum "$ROOTFS_PATH" | cut -d ' ' -f 1)"
    [ "$ACTUAL_ROOTFS_SHA256" = "$EXPECTED_ROOTFS_SHA256" ] || fail rootfs-checksum
fi

[ -f "$TOKEN_PATH" ] || fail token-missing
TOKEN="$(tr -d '\r\n' < "$TOKEN_PATH")"
[ "${#TOKEN}" -eq 64 ] || fail token-format
case "$TOKEN" in *[!0-9a-f]*) fail token-format ;; esac

/sbin/mkfs.ext4 -F -L droidlayer-root "$ROOT_DEVICE" || fail format-root
mount -t ext4 "$ROOT_DEVICE" /newroot || fail mount-root
case "$ROOTFS_PATH" in
    *.tar.xz|*.txz) tar -xJpf "$ROOTFS_PATH" -C /newroot || fail unpack-rootfs ;;
    *.tar.gz|*.tgz) tar -xzpf "$ROOTFS_PATH" -C /newroot || fail unpack-rootfs ;;
    *) tar -xpf "$ROOTFS_PATH" -C /newroot || fail unpack-rootfs ;;
esac

mkdir -p /newroot/etc/droidlayer
chmod 0700 /newroot/etc/droidlayer
umask 077
printf '%s\n' "$TOKEN" > /newroot/etc/droidlayer/bridge.token
chmod 0600 /newroot/etc/droidlayer/bridge.token

GUEST_PASS_PATH="$INPUT_DIR/guest.password"
if [ -f "$GUEST_PASS_PATH" ]; then
    GUEST_PASS="$(tr -d '\r\n' < "$GUEST_PASS_PATH")"
    if [ -n "$GUEST_PASS" ]; then
        if [ -x /newroot/usr/sbin/chpasswd ]; then
            printf 'root:%s\n' "$GUEST_PASS" | chroot /newroot /usr/sbin/chpasswd 2>/dev/null || true
        elif [ -x /newroot/usr/bin/chpasswd ]; then
            printf 'root:%s\n' "$GUEST_PASS" | chroot /newroot /usr/bin/chpasswd 2>/dev/null || true
        elif [ -x /newroot/sbin/chpasswd ]; then
            printf 'root:%s\n' "$GUEST_PASS" | chroot /newroot /sbin/chpasswd 2>/dev/null || true
        fi
    fi
fi

mkdir -p /newroot/usr/sbin /newroot/etc/init.d /newroot/etc/conf.d
cp /opt/droidlayer/guest-agent /newroot/usr/sbin/droidlayer-guest-agent
cp /opt/droidlayer/openrc/droidlayer-guest-agent \
    /newroot/etc/init.d/droidlayer-guest-agent
cp /opt/droidlayer/openrc/droidlayer-guest-agent.conf \
    /newroot/etc/conf.d/droidlayer-guest-agent
chmod 0755 /newroot/usr/sbin/droidlayer-guest-agent \
    /newroot/etc/init.d/droidlayer-guest-agent
chmod 0644 /newroot/etc/conf.d/droidlayer-guest-agent
if [ "$BRIDGE_DEVICE_MAPPED" -eq 1 ]; then
    cat >> /newroot/etc/conf.d/droidlayer-guest-agent <<'EOF'
bridge_stream=/dev/droidlayer-bridge
terminal_device=/dev/droidlayer-terminal
EOF
    mkdir -p /newroot/etc/runlevels/default
    ln -s /etc/init.d/droidlayer-guest-agent \
        /newroot/etc/runlevels/default/droidlayer-guest-agent 2>/dev/null \
        || true
    install_official_alpine_busybox_init_fallback /newroot
    install_official_debian_systemd_flavor /newroot
    install_guest_shell_profile /newroot
fi

mkdir -p /newroot/mnt/downloads /newroot/media/downloads
if [ -f /newroot/etc/fstab ]; then
    if ! grep -qs 'downloads.*mnt/downloads' /newroot/etc/fstab; then
        printf 'downloads\t/mnt/downloads\t9p\ttrans=virtio,version=9p2000.L,ro,nofail\t0\t0\n' >> /newroot/etc/fstab
    fi
fi

mkdir -p /newroot/var/lib/droidlayer
chmod 0755 /newroot/var/lib/droidlayer
DISTRO_TAG="alpine-3.24.1"
if is_official_debian_systemd_init /newroot; then
    DISTRO_TAG="debian-13"
fi
printf 'provisioning_version=1\ndistro=%s\n' "$DISTRO_TAG" \
    > /newroot/var/lib/droidlayer/provisioned-v1
sync
log "DROIDLAYER_PROVISIONING_COMPLETE version=1 distro=$DISTRO_TAG"
if [ "$BRIDGE_DEVICE_MAPPED" -eq 0 ] || [ "$(kernel_argument droidlayer.poweroff || true)" = "1" ]; then
    umount /newroot || true
    poweroff -f || true
    while :; do sleep 3600; done
fi
mkdir -p /newroot/dev /newroot/proc /newroot/sys
[ -x /newroot/sbin/init ] || [ -x /newroot/lib/systemd/systemd ] || fail root-init-missing
mount --move /dev /newroot/dev || fail move-dev
mount --move /proc /newroot/proc || fail move-proc
mount --move /sys /newroot/sys || fail move-sys
exec /sbin/switch_root /newroot /sbin/init || fail switch-root
