#!/bin/sh
__droidlayer_git_branch() {
    _cur="${PWD:-.}"
    _git=""
    while [ -n "$_cur" ]; do
        if [ -e "$_cur/.git" ]; then
            if [ -d "$_cur/.git" ]; then
                _git="$_cur/.git"
            elif [ -f "$_cur/.git" ]; then
                read -r _line < "$_cur/.git" 2>/dev/null || _line=""
                case "$_line" in
                    gitdir:*)
                        _dest="${_line#gitdir: }"
                        case "$_dest" in
                            /*) _git="$_dest" ;;
                            *) _git="$_cur/$_dest" ;;
                        esac
                        ;;
                esac
            fi
            break
        fi
        _up="${_cur%/*}"
        [ "$_up" = "$_cur" ] && break
        _cur="$_up"
    done
    [ -n "$_git" ] && [ -f "$_git/HEAD" ] || return 0
    read -r _ref < "$_git/HEAD" 2>/dev/null || return 0
    case "$_ref" in
        ref:\ refs/heads/*) printf '%s' "${_ref#ref: refs/heads/}" ;;
        ref:\ refs/*) printf '%s' "${_ref#ref: refs/}" ;;
        *)
            if [ "${#_ref}" -ge 7 ]; then
                printf '%.7s' "$_ref"
            else
                printf '%s' "$_ref"
            fi
            ;;
    esac
}
__droidlayer_dir() {
    _cwd="${PWD:-$(pwd)}"
    if [ -n "${HOME:-}" ] && [ "$_cwd" = "$HOME" ]; then
        printf '~'
    elif [ -n "${HOME:-}" ]; then
        case "$_cwd" in
            "$HOME"/*) printf '~%s' "${_cwd#"$HOME"}" ;;
            *) printf '%s' "$_cwd" ;;
        esac
    else
        printf '%s' "$_cwd"
    fi
}
__droidlayer_build_prompt() {
    _last_exit="${1:-0}"
    _mode="${2:-sh}"
    _esc=$(printf '\033')
    if [ "$_mode" = "bash" ]; then
        _c_reset="\[${_esc}[0m\]"
        _c_cyan="\[${_esc}[36m\]"
        _c_yellow="\[${_esc}[33m\]"
        _c_red="\[${_esc}[31m\]"
        _c_green="\[${_esc}[32m\]"
        _c_magenta="\[${_esc}[35m\]"
    else
        _c_reset="${_esc}[0m"
        _c_cyan="${_esc}[36m"
        _c_yellow="${_esc}[33m"
        _c_red="${_esc}[31m"
        _c_green="${_esc}[32m"
        _c_magenta="${_esc}[35m"
    fi
    _dir_str="$(__droidlayer_dir)"
    _branch="$(__droidlayer_git_branch)"
    _git_part=""
    if [ -n "$_branch" ]; then
        _git_part=" ${_c_yellow}(${_branch})${_c_reset}"
    fi
    _err_part=""
    if [ "$_last_exit" -ne 0 ]; then
        _err_part=" ${_c_red}✘${_c_reset}"
    fi
    _arrow_color="$_c_green"
    if [ "${UID:-1}" -eq 0 ] 2>/dev/null || [ "${USER:-}" = "root" ]; then
        _arrow_color="$_c_magenta"
    elif command -v id >/dev/null 2>&1 && [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        _arrow_color="$_c_magenta"
    fi
    printf '%s%s%s%s%s\n%s❯%s ' \
        "$_c_cyan" "$_dir_str" "$_c_reset" "$_git_part" "$_err_part" \
        "$_arrow_color" "$_c_reset"
}
if [ -n "${BASH_VERSION:-}" ]; then
    __droidlayer_prompt_cmd() {
        _exit_status="$?"
        PS1="$(__droidlayer_build_prompt "$_exit_status" bash)"
    }
    PROMPT_COMMAND=__droidlayer_prompt_cmd
    PS1="$(__droidlayer_build_prompt 0 bash)"
else
    PS1='$(__droidlayer_build_prompt "$?" sh)'
fi
export PS1
EOF
