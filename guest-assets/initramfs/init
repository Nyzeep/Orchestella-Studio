        umount /newroot || fail unmount-unrecognized-root
        fail root-volume-unrecognized
    fi
    [ -x /newroot/sbin/init ] || [ -x /newroot/lib/systemd/systemd ] || fail root-init-missing
    mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/mnt/downloads /newroot/media/downloads
    if [ -f /newroot/etc/fstab ]; then
        if ! grep -qs 'downloads.*mnt/downloads' /newroot/etc/fstab; then
            printf 'downloads\t/mnt/downloads\t9p\ttrans=virtio,version=9p2000.L,ro,nofail\t0\t0\n' >> /newroot/etc/fstab
        fi
    fi
    # Auto online resize ext4 root filesystem if root-volume was resized (ADR-0007 / Ticket 33)
    if [ -x /sbin/resize2fs ]; then
        /sbin/resize2fs "$ROOT_DEVICE" 2>/dev/null || true
    elif [ -x /newroot/sbin/resize2fs ]; then
        /newroot/sbin/resize2fs "$ROOT_DEVICE" 2>/dev/null || true
