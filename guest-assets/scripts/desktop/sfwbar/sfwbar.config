# DroidLayer sfwbar status bar configuration

# Trigger definitions and appearance
theme = "Adwaita"

# Taskbar and window switcher
taskbar {
  rows = 1
  labels = true
  icons = true
  title_width = 24
  group = false
}

# Application launcher menu
menu("appmenu") {
  item("Terminal (foot)", Exec "foot")
  item("File Manager", Exec "pcmanfm")
  item("Text Editor", Exec "gedit")
  item("Web Browser", Exec "firefox")
  separator
  item("Reload sfwbar", Reload)
}

# Main layout definition
layout {
  bar {
    position = "bottom"
    layer = "top"
    height = 36
    css = "* { font: 11pt Noto Sans; }"

    button {
      label = "DroidLayer"
      action = Menu("appmenu")
    }

    grid {
      css = "* { min-width: 4px; }"
    }

    taskbar {
      css = "* { min-height: 28px; }"
    }

    pager {
      rows = 1
      preview = false
    }

    tray {
      rows = 1
    }

    label {
      value = Time("%H:%M")
      interval = 1000
    }
  }
}
