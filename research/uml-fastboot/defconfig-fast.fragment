# U1 fast-shell UML profile — deliberate deltas from the pinned release config.
#
# Applied by build-fast.sh:
#   ARM64 UP  : research/uml-kernel-build/defconfigs/linux-bionic.config
#   ARM64 SMP : defconfig-fast + CONFIG_SMP=y + NR_CPUS=8
#   x86_64    : arch/x86/configs/x86_64_defconfig + this fragment
# then `make olddefconfig`, so every value below is re-resolved against the
# pinned Kconfig before it reaches the build.
#
# Goal: boot to a shell (T3) with cgroup v2, devtmpfs, devpts, proc/sysfs,
# ext4, ubd, hostfs and vector networking.  No systemd/Docker/network-service
# promise; those belong to the full profile.
#
# The checked-in `defconfig-fast` is the resolved ARM64 UP result of
# base + this fragment.  Keep this file and that file in sync.

# ---------------------------------------------------------------------------
# Keep: the fast-shell contract (explicit so a base-config change cannot drop
# it silently).
# ---------------------------------------------------------------------------
CONFIG_UML=y
CONFIG_MMU=y
CONFIG_HOSTFS=y
CONFIG_BLK_DEV_UBD=y
CONFIG_BLK_DEV_INITRD=y
# The compression choice is hidden while INITRAMFS_SOURCE is empty; build-fast.sh
# sets it after pointing CONFIG_INITRAMFS_SOURCE at the staged cpio.
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_BLK_CGROUP=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_UNIX98_PTYS=y
CONFIG_NULL_CHAN=y
CONFIG_MCONSOLE=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_KALLSYMS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_STATIC_LINK=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set
CONFIG_HZ_100=y
# T1 parsing needs a kernel timestamp on the "Run /init" line.
CONFIG_PRINTK_TIME=y
# Monolithic: no module loading before/after T3.
# CONFIG_MODULES is not set
# CONFIG_RUST is not set
# Vector networking stays available for U3; it is not part of the T3 promise.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UML_NET_VECTOR=y
CONFIG_TUN=y

# ---------------------------------------------------------------------------
# Cut: debug/trace infrastructure.  The release binaries are stripped before
# shipping, and the fast profile needs panic traces, not DWARF or ftrace.
# ---------------------------------------------------------------------------
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_FRAME_POINTER is not set
# CONFIG_FTRACE is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_DEBUG_MISC is not set
# CONFIG_COREDUMP is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_DEVMEM is not set
# Deterministic kernel version string for the tarball build.
# CONFIG_LOCALVERSION_AUTO is not set

# ---------------------------------------------------------------------------
# Cut: hardware/user-input subsystems UML cannot bind to real hardware in the
# App domain, or that the fast shell never opens.
# ---------------------------------------------------------------------------
# CONFIG_INPUT is not set
# NOTE: drivers/tty/Kconfig selects INPUT for UML's mandatory TTY, so the
# resolved config keeps CONFIG_INPUT=y.  All input drivers (HID/SERIO/...) are
# off; this line documents the intent, not the final value.
# CONFIG_HID is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_SERIO is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_ETHERNET is not set
# CONFIG_NETCONSOLE is not set
# CONFIG_NETFILTER is not set
# CONFIG_NET_SCHED is not set
# CONFIG_NET_9P is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_PSI is not set
# CONFIG_AUDIT is not set
# CONFIG_SECURITY is not set
# CONFIG_USER_NS is not set
# CONFIG_PID_NS is not set
# CONFIG_MEMCG is not set
# CONFIG_CGROUP_BPF is not set

# ---------------------------------------------------------------------------
# Cut: filesystem/block paths outside the fast contract.  ext4+ubd+hostfs+
# tmpfs remain; loop/NBD/ISO9660/autofs/quota are full-profile or U5 concerns.
# ---------------------------------------------------------------------------
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_BLK_DEV_NBD is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_AUTOFS_FS is not set
# CONFIG_QUOTA is not set
# CONFIG_FUSE_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_NLS is not set

# ---------------------------------------------------------------------------
# Cut: UML line channels the fast profile does not use.  con=null plus the
# fd channel (always built in) are enough for con0=null,fd:1.
# ---------------------------------------------------------------------------
# CONFIG_PORT_CHAN is not set
# CONFIG_PTY_CHAN is not set
# CONFIG_TTY_CHAN is not set
# CONFIG_XTERM_CHAN is not set
# CONFIG_LEGACY_PTYS is not set

# ---------------------------------------------------------------------------
# Cut: formats/protocols not needed before T3.
# ---------------------------------------------------------------------------
# CONFIG_BINFMT_MISC is not set
# CONFIG_PPP is not set
# CONFIG_SLIP is not set
# CONFIG_DUMMY is not set

# ---------------------------------------------------------------------------
# Cut: initrd decompressors other than gzip (smaller decompressor set).
# ---------------------------------------------------------------------------
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
