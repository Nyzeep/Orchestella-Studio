#!/bin/busybox sh
# Orchestella Studio — full-smp-arm64 UML init (PID 1).
#
# Contract:
#   1. Mount /proc, /sys, /dev, /dev/pts, /run, and /sys/fs/cgroup (cgroup2).
#   2. If umroot= and umrootfstype= are provided:
#      - Mount the target root (/dev/ubda ext4 or hostfs path) onto /newroot.
#      - Prepare /newroot/{proc,sys,dev,dev/pts,run,sys/fs/cgroup} and mount/move
#        required pseudo-filesystems so systemd or shell scripts see a valid tree.
#      - If uminit= is specified (e.g. uminit=/sbin/init), verify executable and
#        hand off PID 1 via switch_root to that init directly.
#      - Else if /newroot/um-command.sh is executable, switch_root to it
#        (preserves existing provisioner and Alpine persistent launch path).
#      - Else if /newroot/sbin/init is executable, switch_root to /sbin/init.
#   3. Otherwise exec /um-command.sh (or /bin/sh when um.shell=1).
#
# Failure policy: emit one structured UM_INIT_ERROR line, sync, and poweroff -f.

set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

fail() {
    code=$1
    step=$2
    shift 2
    printf 'UM_INIT_ERROR code=%s step=%s detail=%s\n' "$code" "$step" "$*" >&2
    printf 'UM_INIT_FAIL step=%s\n' "$step" >&2
    sync 2>/dev/null || :
    poweroff -f 2>/dev/null || :
    while :; do sleep 3600; done
}

is_mounted() {
    grep -q " $1 " /proc/mounts 2>/dev/null
}

mount_pseudo() {
    mp=$1
    fstype=$2
    src=$3
    opts=$4
    mkdir -p "$mp" || fail 20 mkdir "$mp"
    is_mounted "$mp" && return 0
    if [ -n "$opts" ]; then
        mount -t "$fstype" -o "$opts" "$src" "$mp" || return 1
    else
        mount -t "$fstype" "$src" "$mp" || return 1
    fi
}

move_or_mount_pseudo() {
    src_mp=$1
    dst_mp=$2
    fstype=$3
    src_dev=$4
    opts=$5
    mkdir -p "$dst_mp" || return 1
    if is_mounted "$dst_mp"; then
        return 0
    fi
    if is_mounted "$src_mp"; then
        mount --move "$src_mp" "$dst_mp" 2>/dev/null && return 0
    fi
    mount_pseudo "$dst_mp" "$fstype" "$src_dev" "$opts"
}

cmdline_param() {
    key=$1
    for word in $(cat /proc/cmdline 2>/dev/null); do
        case "$word" in
            "$key"=*) printf '%s' "${word#*=}"; return 0 ;;
        esac
    done
    return 1
}

# /proc first: subsequent checks inspect /proc/mounts and /proc/cmdline.
mount_pseudo /proc proc proc nosuid,nodev,noexec || fail 10 mount_proc /proc
mount_pseudo /sys sysfs sysfs nosuid,nodev,noexec || fail 11 mount_sys /sys
mount_pseudo /dev devtmpfs devtmpfs nosuid,mode=0755 || fail 12 mount_dev /dev
mount_pseudo /dev/pts devpts devpts nosuid,noexec,gid=5,mode=620 \
    || fail 13 mount_devpts /dev/pts
mount_pseudo /run tmpfs tmpfs nosuid,nodev,mode=0755 || fail 15 mount_run /run
mount_pseudo /sys/fs/cgroup cgroup2 cgroup2 nosuid,nodev,noexec \
    || fail 14 mount_cgroup2 /sys/fs/cgroup

umroot=$(cmdline_param umroot || :)
umrootfstype=$(cmdline_param umrootfstype || :)
uminit=$(cmdline_param uminit || :)

if [ -n "$umroot" ] && [ -n "$umrootfstype" ]; then
    mkdir -p /newroot || fail 21 mkdir /newroot
    case "$umrootfstype" in
        hostfs)
            mount -t hostfs -o "$umroot" none /newroot \
                || fail 22 mount_hostfs "root=$umroot"
            ;;
        *)
            mount -t "$umrootfstype" "$umroot" /newroot \
                || fail 23 mount_root "fstype=$umrootfstype root=$umroot"
            ;;
    esac

    move_or_mount_pseudo /dev /newroot/dev devtmpfs devtmpfs nosuid,mode=0755 \
        || fail 26 mount_root_dev /newroot/dev
    move_or_mount_pseudo /dev/pts /newroot/dev/pts devpts devpts nosuid,noexec,gid=5,mode=620 \
        || fail 27 mount_root_devpts /newroot/dev/pts
    move_or_mount_pseudo /run /newroot/run tmpfs tmpfs nosuid,nodev,mode=0755 \
        || fail 29 mount_root_run /newroot/run
    move_or_mount_pseudo /sys /newroot/sys sysfs sysfs nosuid,nodev,noexec \
        || fail 25 mount_root_sys /newroot/sys
    move_or_mount_pseudo /sys/fs/cgroup /newroot/sys/fs/cgroup cgroup2 cgroup2 nosuid,nodev,noexec \
        || fail 28 mount_root_cgroup2 /newroot/sys/fs/cgroup
    move_or_mount_pseudo /proc /newroot/proc proc proc nosuid,nodev,noexec \
        || fail 24 mount_root_proc /newroot/proc

    if [ -n "$uminit" ]; then
        case "$uminit" in
            /*) ;;
            *) fail 31 invalid_uminit "uminit=$uminit" ;;
        esac
        [ -x "/newroot$uminit" ] || [ -L "/newroot$uminit" ] \
            || fail 32 missing_uminit "/newroot$uminit"
        exec /bin/busybox switch_root /newroot "$uminit"
    fi

    if [ -x /newroot/um-command.sh ]; then
        exec /bin/busybox switch_root /newroot /bin/busybox sh /um-command.sh
    fi

    if [ -x /newroot/sbin/init ] || [ -L /newroot/sbin/init ]; then
        exec /bin/busybox switch_root /newroot /sbin/init
    fi

    fail 33 missing_command "/newroot/um-command.sh"
fi

if [ "$(cmdline_param um.shell || :)" = 1 ]; then
    exec /bin/sh
fi
[ -x /um-command.sh ] || fail 30 missing_command "/um-command.sh"
exec /bin/busybox sh /um-command.sh
