#!/bin/sh
# init-zero-install — PID 1 for the pre-baked fast-shell lane.
#
# Contract:
#   * mount /proc, /sys, /dev, /dev/pts and cgroup2
#   * exec /ready.sh
#   * never invoke a package manager
#   * never configure or require a network
#
# The image was provisioned at build time. Anything this script would have to
# install, download or generate is a build bug, not a first-boot step.

set -u

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
LANG="${LANG:-C.UTF-8}"
LC_ALL="${LC_ALL:-C.UTF-8}"
export LANG LC_ALL

log() { printf '%s\n' "$*"; }

uptime_s() {
    if read -r up _ < /proc/uptime 2>/dev/null; then
        printf '%s' "$up"
    else
        printf 'unknown'
    fi
}

mount_required() {
    fs="$1"; src="$2"; dst="$3"; opts="${4:-}"
    mkdir -p "$dst"
    if [ -n "$opts" ]; then
        mount -t "$fs" -o "$opts" "$src" "$dst" 2>/dev/null && return 0
    else
        mount -t "$fs" "$src" "$dst" 2>/dev/null && return 0
    fi
    log "INIT_MOUNT_FAILED fs=$fs target=$dst"
    return 1
}

mount_optional() {
    fs="$1"; src="$2"; dst="$3"; opts="${4:-}"
    mkdir -p "$dst"
    if [ -n "$opts" ]; then
        mount -t "$fs" -o "$opts" "$src" "$dst" 2>/dev/null && return 0
    else
        mount -t "$fs" "$src" "$dst" 2>/dev/null && return 0
    fi
    log "INIT_MOUNT_SKIPPED fs=$fs target=$dst"
    return 1
}

log "INIT_ZERO_INSTALL stage=mounts"

is_mounted() {
    grep -q " $1 " /proc/mounts 2>/dev/null
}

if is_mounted /proc; then
    log "INIT_MOUNT_PRESENT fs=proc target=/proc"
else
    mount_required proc proc /proc || exit 70
fi

if is_mounted /sys; then
    log "INIT_MOUNT_PRESENT fs=sysfs target=/sys"
else
    mount_required sysfs sysfs /sys || exit 70
fi

if is_mounted /dev; then
    # The kernel may have mounted devtmpfs itself (CONFIG_DEVTMPFS_MOUNT).
    log "INIT_MOUNT_PRESENT fs=dev target=/dev"
elif ! mount_required devtmpfs devtmpfs /dev; then
    # UML kernels without devtmpfs still need console/null/zero for init.
    mount_required tmpfs tmpfs /dev || exit 70
    mknod -m 620 /dev/console c 5 1 2>/dev/null || true
    mknod -m 666 /dev/null c 1 3 2>/dev/null || true
    mknod -m 666 /dev/zero c 1 5 2>/dev/null || true
    mknod -m 666 /dev/tty c 5 0 2>/dev/null || true
fi

if is_mounted /dev/pts; then
    log "INIT_MOUNT_PRESENT fs=devpts target=/dev/pts"
else
    mount_required devpts devpts /dev/pts "gid=5,mode=620,ptmxmode=000" \
        || mount_required devpts devpts /dev/pts "gid=5,mode=620" \
        || exit 70
fi

# cgroup2 is best-effort: the fast shell works without it, full-systemd/Docker
# profiles require it. A missing mount is reported, never silently assumed.
if is_mounted /sys/fs/cgroup; then
    log "INIT_MOUNT_PRESENT fs=cgroup2 target=/sys/fs/cgroup"
else
    mount_optional cgroup2 none /sys/fs/cgroup || true
fi

if command -v hostname >/dev/null 2>&1 && [ -r /etc/hostname ]; then
    hostname -F /etc/hostname 2>/dev/null || true
fi

log "T2_MOUNTS_READY uptime=$(uptime_s)"

if [ ! -x /ready.sh ]; then
    log "INIT_ERROR missing /ready.sh"
    exit 71
fi

exec /ready.sh
