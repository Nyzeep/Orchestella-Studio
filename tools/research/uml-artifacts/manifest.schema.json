{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestella.invalid/schemas/uml-artifact-manifest-v1.json",
  "title": "UML research artifact manifest",
  "description": "Provenance for one UML research artifact set (kernel/stub/initramfs/rootfs): source pin, toolchain, build command, artifact digests and the GPL-2.0 corresponding-source obligations recorded for that set. Research scope only; this is not a release manifest and carries no signing or version claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "setId",
    "createdAt",
    "artifactRoot",
    "toolchain",
    "build",
    "artifacts",
    "gpl"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "enum": [
        "kernel-set",
        "rootfs-set"
      ]
    },
    "setId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifactRoot": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "$ref": "#/$defs/kernelSource"
    },
    "toolchain": {
      "$ref": "#/$defs/toolchain"
    },
    "build": {
      "$ref": "#/$defs/build"
    },
    "kernel": {
      "$ref": "#/$defs/kernel"
    },
    "stub": {
      "$ref": "#/$defs/stub"
    },
    "initramfs": {
      "$ref": "#/$defs/initramfs"
    },
    "rootfs": {
      "$ref": "#/$defs/rootfs"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "gpl": {
      "$ref": "#/$defs/gpl"
    }
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "kernel-set"
        }
      },
      "required": [
        "source",
        "kernel"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "rootfs-set"
        }
      },
      "required": [
        "rootfs"
      ]
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "filePin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "kernelSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "tag",
        "commit",
        "version",
        "license",
        "tarballSha256"
      ],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "const": "GPL-2.0-only"
        },
        "tarballSha256": {
          "$ref": "#/$defs/sha256"
        },
        "upstreamBaseline": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "compiler",
        "buildContainer",
        "hostArch",
        "byteReproducible",
        "reproducibilityNote"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "buildContainer": {
          "type": "string",
          "minLength": 1
        },
        "hostArch": {
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "byteReproducible": {
          "type": "boolean"
        },
        "reproducibilityNote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "command",
        "env"
      ],
      "properties": {
        "script": {
          "$ref": "#/$defs/filePin"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "type": "object",
          "description": "Build inputs required for a deterministic rebuild. These are the pins a rebuild must supply; they are not necessarily a transcript of the original build environment.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defconfig"
      ],
      "properties": {
        "defconfig": {
          "$ref": "#/$defs/filePin"
        },
        "effectiveConfig": {
          "$ref": "#/$defs/filePin"
        }
      }
    },
    "stub": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pAlign"
      ],
      "properties": {
        "pAlign": {
          "type": "integer",
          "enum": [
            4096,
            16384,
            65536
          ]
        }
      }
    },
    "initramfs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "init",
        "sources"
      ],
      "properties": {
        "format": {
          "const": "cpio.gz"
        },
        "init": {
          "$ref": "#/$defs/filePin"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "url": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "rootfs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distro",
        "manifestPath",
        "manifestSha256",
        "outputs",
        "provisioning"
      ],
      "properties": {
        "distro": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "arch",
            "libc"
          ],
          "properties": {
            "name": {
              "enum": [
                "alpine",
                "debian"
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "arch": {
              "enum": [
                "aarch64",
                "x86_64"
              ]
            },
            "libc": {
              "enum": [
                "musl",
                "glibc"
              ]
            }
          }
        },
        "manifestPath": {
          "$ref": "#/$defs/relPath"
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "format",
              "sha256",
              "sizeBytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "enum": [
                  "tar.gz",
                  "ext4"
                ]
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "provisioning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "firstBootPackageManagerInvocations",
            "networkRequired"
          ],
          "properties": {
            "firstBootPackageManagerInvocations": {
              "type": "integer",
              "const": 0
            },
            "networkRequired": {
              "type": "boolean",
              "const": false
            }
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "role",
        "path",
        "sha256",
        "sizeBytes",
        "format"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,80}$"
        },
        "component": {
          "enum": [
            "kernel",
            "stub",
            "initramfs",
            "rootfs"
          ]
        },
        "role": {
          "enum": [
            "kernel",
            "kernel-no-initramfs",
            "stub",
            "initramfs",
            "rootfs-archive",
            "rootfs-ext4",
            "config"
          ]
        },
        "path": {
          "$ref": "#/$defs/relPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "enum": [
            "elf",
            "cpio.gz",
            "tar.gz",
            "ext4",
            "raw"
          ]
        },
        "pAlign": {
          "type": "integer",
          "enum": [
            4096,
            16384,
            65536
          ]
        }
      }
    },
    "gpl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license",
        "obligations",
        "sourceComponents",
        "buildScripts",
        "bundle"
      ],
      "properties": {
        "license": {
          "const": "GPL-2.0-only"
        },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceComponents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "license",
              "url",
              "revision",
              "covers"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "covers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "kernel",
                    "stub",
                    "initramfs",
                    "rootfs"
                  ]
                }
              }
            }
          }
        },
        "buildScripts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/filePin"
          }
        },
        "bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "script",
            "format"
          ],
          "properties": {
            "script": {
              "$ref": "#/$defs/filePin"
            },
            "format": {
              "const": "tar.gz"
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
